// moon-postgres: a pure-MoonBit PostgreSQL wire-protocol driver (v3), no C.
// The connection layer rides moonbitlang/async sockets, so the package is
// native-only (the async runtime has no JS/wasm backend). See README §"The
// async wall" for why the @moondb.Driver conformance is a synchronous façade
// over an async core.
supported_targets = "native"

import {
  "Lfan-ke/moondb",
  "moonbitlang/async",
  "moonbitlang/async/socket",
  "moonbitlang/async/io",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/double",
}
