// moon-sqlite: the native SQLite driver for the moondb interface. It implements
// `@moondb.Driver` over the vendored SQLite amalgamation (in `sqlite/`), so every
// moondb-based query layer (moonorm and friends) runs on real SQLite. This is the
// only package in the stack that touches C; it is native-gated for that reason, and
// the amalgamation is isolated here so nothing above it leaves pure MoonBit.

supported_targets = "native"

import {
  "Lfan-ke/moondb",
  "moonbitlang/core/encoding/utf8",
}

options(
  "native-stub": [ "sqlite/stub.c", "sqlite/sqlite3.c" ],
)
