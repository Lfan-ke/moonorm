// moon-mysql (root) — the pure, target-portable half of the driver: SHA-1, the
// MySQL packet codec (length-encoded ints/strings, fixed-width little-endian
// integers), the handshake parser, the mysql_native_password scramble, and the
// text-protocol value decoder. No sockets and no async live here, so every byte
// of the wire format is unit-tested on *all* backends. The socket transport and
// the @moondb.Driver implementation live in the native-only `client` package.
import {
  "Lfan-ke/moondb",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
}
